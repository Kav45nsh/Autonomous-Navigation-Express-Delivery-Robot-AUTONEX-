# Copy to .env and edit. Overrides config/settings.py without touching code.
# Never commit .env.

# ── platform ───────────────────────────────────────────────
# ROBOT_PLATFORM=laptop          # auto | laptop | pi  (auto-detects by default)
# LOG_LEVEL=DEBUG
# HEADLESS=true                  # no preview window (set automatically on Pi)

# ── camera ─────────────────────────────────────────────────
# CAMERA_INDEX=1                 # 1 = external USB webcam
# CAMERA_BACKEND=webcam          # webcam | picamera2

# ── face recognition ───────────────────────────────────────
# FACE_BACKEND=lbph              # lbph avoids the 90-minute dlib build on Pi

# ── THE UNLOCK RULE ────────────────────────────────────────
# UNLOCK_CONFIDENCE_THRESHOLD=0.50
# AUTH_REQUIRED_STREAK=4
# AUTH_MIN_MARGIN=0.08
# REQUIRE_LIVENESS=false

# ── lock ───────────────────────────────────────────────────
# LOCK_BACKEND=simulated         # simulated | gpio
# UNLOCK_DURATION_SECONDS=5

# ── mission ────────────────────────────────────────────────
# TARGET_DESTINATION=WP-DEST-01
# DEFAULT_SPEED=0.55
# OBSTACLE_STOP_CM=25

# ── esp32 ──────────────────────────────────────────────────
# ESP32_ENABLED=false
# ESP32_PORT=/dev/ttyUSB0
